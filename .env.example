APP_PORT=8080
APP_ENV=development

# localhost ไว้รันบนเครื่อง — docker compose override เป็น postgres ให้เอง ไม่ต้องแก้
# comment ต้องอยู่บรรทัดของตัวเอง Makefile include ไฟล์นี้ ค่าจะติดขยะถ้าเขียนต่อท้าย
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blog_user_api
DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_READ_HEADER_TIMEOUT=5s

JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
